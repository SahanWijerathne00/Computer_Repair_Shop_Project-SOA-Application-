<?xml version="1.0" encoding="utf-8" ?>
<configuration>
	<connectionStrings>
		<add name="TechDatabaseConnectionString"
			 connectionString="Data Source=SERVER_NAME;Initial Catalog=DATABASE_NAME;User ID=USERNAME;Password=PASSWORD;Integrated Security=False;"
			 providerName="System.Data.SqlClient" />
	</connectionStrings>
</configuration>
